begin
	gsay_reply(SCRIPT_AIRGRD, 134);
	giq_option(4, SCRIPT_AIRGRD, 135, airgrd02, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 136, airgrd12, BAD_REACTION);
end


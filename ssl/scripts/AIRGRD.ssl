variable exit_line;


procedure start
begin
	if (only_once) then begin
		only_once := 0;
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 34);
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_SUPER_MUTANT_GUARD);
	end
	else begin
		if (script_action == damage_proc) then begin
			if (global_var(GVAR_ENEMY_VAULT_13) == 0) then begin
				set_global_var(GVAR_ENEMY_VAULT_13, 1);
			end
		end
		else begin
			if (script_action == talk_proc) then begin
				call do_dialogue;
			end
			else begin
				if (script_action == pickup_proc) then begin
					HOSTILE := 1;
				end
				else begin
					if (script_action == timed_event_proc) then begin
						if ((obj_item_subtype(critter_inven_obj(dude_obj, 1)) == 3) or (obj_item_subtype(critter_inven_obj(dude_obj, 2)) == 3)) then begin
							call combat;
						end
					end
					else begin
						if (script_action == critter_proc) then begin
							if (HOSTILE) then begin
								HOSTILE := 0;
								attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
							end
							if (obj_can_see_obj(self_obj, dude_obj) and (tile_distance_objs(self_obj, dude_obj) < 6)) then begin
								if ((obj_item_subtype(critter_inven_obj(dude_obj, 1)) == 3) or (obj_item_subtype(critter_inven_obj(dude_obj, 2)) == 3)) then begin
									if (Weapons == 0) then begin
										Weapons := 1;
										again := 1;
										dialogue_system_enter;
									end
								end
								DISGUISED := 0;
								if (obj_pid(critter_inven_obj(dude_obj, 0)) == 113) then begin
									if (metarule(16, 0) > 1) then begin
										DISGUISED := 0;
									end
									else begin
										DISGUISED := 1;
									end
								end
								if (DISGUISED == 0) then begin
									again := 1;
									dialogue_system_enter;
								end
								if (again == 0) then begin
									again := 1;
									dialogue_system_enter;
								end
							end
						end
						else begin
							if ((script_action == look_at_proc) or (script_action == description_proc)) then begin
								script_overrides;
							end
							else begin
								if (script_action == destroy_proc) then begin
									if (source_obj == dude_obj) then begin
										if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
											set_global_var(GVAR_BERSERKER_REPUTATION, 1);
											set_global_var(GVAR_CHAMPION_REPUTATION, 0);
										end
										if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
											set_global_var(GVAR_CHAMPION_REPUTATION, 1);
											set_global_var(GVAR_BERSERKER_REPUTATION, 0);
										end
										set_global_var(GVAR_BAD_MONSTER, global_var(GVAR_BAD_MONSTER) + 1);
										if ((global_var(GVAR_BAD_MONSTER) % 6) == 0) then begin
											set_global_var(GVAR_PLAYER_REPUTATION, global_var(GVAR_PLAYER_REPUTATION) + 1);
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

procedure do_dialogue
begin
	if (obj_pid(critter_inven_obj(dude_obj, 0)) == 113) then begin
		if (metarule(16, 0) > 1) then begin
			DISGUISED := 0;
		end
		else begin
			DISGUISED := 1;
		end
	end
	if ((map_var(1) == 1) and (global_var(GVAR_MASTER_FILLER_4) == 1)) then begin
		call airgrd00;
	end
	else begin
		if (DISGUISED) then begin
			if (Weapons) then begin
				jumpcode := 1;
				call dialog;
			end
			else begin
				if (first == 0) then begin
					first := 1;
					jumpcode := 2;
					call dialog;
				end
				else begin
					if (first == 1) then begin
						call airgrd08;
					end
				end
			end
		end
		else begin
			if (Weapons) then begin
				call airgrd15;
			end
			else begin
				jumpcode := 3;
				call dialog;
			end
		end
	end
end

procedure dialog
begin
	set_local_var(3, 1);
	call Get_Reaction;
	start_gdialog(SCRIPT_AIRGRD, self_obj, 4, -1, -1);
	gsay_start;
	indialog := 1;
	if (jumpcode < 2) then begin
		call airgrd01;
	end
	else begin
		if (jumpcode == 2) then begin
			call airgrd03;
		end
		else begin
			if (jumpcode > 2) then begin
				call airgrd09;
			end
		end
	end
	indialog := 0;
	gsay_end;
	end_dialogue;
end

procedure airgrd00
begin
	float_msg(self_obj, message_str(SCRIPT_AIRGRD, random(102, 104)), FLOAT_MSG_RED);
end

procedure airgrd01
begin
	gsay_reply(SCRIPT_AIRGRD, 105);
	giq_option(-3, SCRIPT_AIRGRD, 106, airgrd02, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 107, airgrdtim, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 108, airgrd02, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 109, airgrdtim, NEUTRAL_REACTION);
end

procedure airgrd02
begin
	gsay_message(SCRIPT_AIRGRD, 110, BAD_REACTION);
	call combat;
end

procedure airgrd03
begin
	gsay_reply(SCRIPT_AIRGRD, 111);
	giq_option(-3, SCRIPT_AIRGRD, 112, airgrd02, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 113, airgrd04, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 114, airgrd03a, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 115, airgrd02, BAD_REACTION);
end

procedure airgrd03a
begin
	if (is_success(roll_vs_skill(dude_obj, 14, 0))) then begin
		call airgrd06;
	end
	else begin
		call airgrd08;
	end
end

procedure airgrd04
begin
	gsay_reply(SCRIPT_AIRGRD, 116);
	giq_option(4, SCRIPT_AIRGRD, 117, airgrd04a, NEUTRAL_REACTION);
	giq_option(6, SCRIPT_AIRGRD, 118, airgrd04b, NEUTRAL_REACTION);
end

procedure airgrd04a
begin
	if (is_success(roll_vs_skill(dude_obj, 14, -30))) then begin
		call airgrd06;
	end
	else begin
		call airgrd05;
	end
end

procedure airgrd04b
begin
	if (is_success(roll_vs_skill(dude_obj, 14, -15))) then begin
		call airgrd06;
	end
	else begin
		call airgrd05;
	end
end

procedure airgrd05
begin
	gsay_message(SCRIPT_AIRGRD, 119, BAD_REACTION);
	call combat;
end

procedure airgrd06
begin
	gsay_reply(SCRIPT_AIRGRD, 120);
	giq_option(4, SCRIPT_AIRGRD, 121, bluff_end, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 122, airgrd07, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 123, bluff_end, NEUTRAL_REACTION);
end

procedure airgrd07
begin
	gsay_message(SCRIPT_AIRGRD, 124, BAD_REACTION);
	call combat;
end

procedure airgrd08
begin
	if (indialog == 1) then begin
		gsay_message(SCRIPT_AIRGRD, random(125, 127), NEUTRAL_REACTION);
	end
	else begin
		float_msg(self_obj, message_str(SCRIPT_AIRGRD, random(125, 127)), FLOAT_MSG_RED);
	end
	call bluff_end;
end

procedure airgrd09
begin
	gsay_reply(SCRIPT_AIRGRD, 128);
	giq_option(-3, SCRIPT_AIRGRD, 129, airgrd10, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 130, airgrd10, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 131, airgrd11, BAD_REACTION);
	giq_option(4, SCRIPT_AIRGRD, 132, airgrd02, BAD_REACTION);
end


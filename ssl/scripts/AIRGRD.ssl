procedure combat;

variable HOSTILE;
variable only_once := 1;
variable Weapons;
variable DISGUISED;
variable again;
variable first;
variable rndx;
variable jumpcode;
variable indialog;
variable temp;

procedure Get_Reaction;
procedure React_To_Level;
procedure Level_To_React;

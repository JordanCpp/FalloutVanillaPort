begin
	gsay_reply(SCRIPT_AIRGRD, 137);
	giq_option(4, SCRIPT_AIRGRD, 138, airgrd13, BAD_REACTION);
	giq_option(6, SCRIPT_AIRGRD, 139, airgrd14, BAD_REACTION);

procedure Cheater07
begin
	poison(dude_obj, 10);
	gsay_message(SCRIPT_CHEATER, "[Hands you a Burrito Supreme] Enjoy your Grade D Beef.", NEUTRAL_REACTION);
	call Cheater00a;
end

procedure Cheater08
begin
	radiation_inc(dude_obj, 50);

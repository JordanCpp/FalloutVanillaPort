	giq_option(4, SCRIPT_HTWRLEON, 119, Leon03, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_HTWRLEON, 120, LeonKickOut, NEUTRAL_REACTION);
end

procedure Leon06
begin
	gsay_message(SCRIPT_HTWRLEON, 121, NEUTRAL_REACTION);
	gsay_message(SCRIPT_HTWRLEON, 122, NEUTRAL_REACTION);
	gsay_reply(SCRIPT_HTWRLEON, 123);
	giq_option(4, SCRIPT_HTWRLEON, 124, Leon07, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_HTWRLEON, 125, LeonCombat, BAD_REACTION);
	giq_option(4, SCRIPT_HTWRLEON, 126, Leon03, NEUTRAL_REACTION);
end

procedure Leon07
begin
	gsay_reply(SCRIPT_HTWRLEON, 127);
	giq_option(4, SCRIPT_HTWRLEON, 128, Leon03, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_HTWRLEON, 129, LeonKickOut, NEUTRAL_REACTION);
end


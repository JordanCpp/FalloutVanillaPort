begin
	if (is_success(roll_vs_skill(dude_obj, 14, 0))) then begin
		call Leon02;
	end
	else begin
		call Leon05;
	end
end

procedure Leon05
begin
	gsay_reply(SCRIPT_HTWRLEON, 116);
	giq_option(4, SCRIPT_HTWRLEON, 117, Leon03, NEUTRAL_REACTION);
	if (global_var(GVAR_KILL_MERCHANT) == 1) then begin
		giq_option(4, SCRIPT_HTWRLEON, 118, Leon06, NEUTRAL_REACTION);

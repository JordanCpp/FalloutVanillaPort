begin
	gsay_reply(SCRIPT_VANCE, 115);
	giq_option(4, SCRIPT_VANCE, 116, Vance13, BAD_REACTION);
	giq_option(4, SCRIPT_VANCE, 117, Vance14, NEUTRAL_REACTION);
end

procedure Vance05
begin
	call Barter;
end


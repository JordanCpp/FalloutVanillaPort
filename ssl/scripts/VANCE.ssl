	giq_option(4, SCRIPT_VANCE, 144, Vance11a, GOOD_REACTION);
end

procedure Vance11a
begin
	if (is_success(roll_vs_skill(dude_obj, 14, -20)) == 1) then begin
		call Vance02;
	end
	else begin
		call Vance13;
	end
end

procedure Vance12
begin
	gsay_reply(SCRIPT_VANCE, 145);

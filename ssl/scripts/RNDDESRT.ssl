  add_mult_objs_to_inven(Critter, Item, 2 * (has_trait(0, dude_obj, 40) + 1));
  Item := create_object_sid(2, 0, 0, -1);
  add_obj_to_inven(Critter, Item);
  if (random(0, 2) == 0) then
    Item := item_caps_adjust(Critter, random(5, 30) * ((2 * has_trait(0, dude_obj, 20)) + 1));
  call stranger;
end

procedure add_party
begin
  variable LVar1 := 0;
  variable LVar2 := 0;

  party_elevation := elevation(dude_obj);
  if (global_var(GVAR_TANDI_STATUS) == 5) then
  begin
    if (Tandi_ptr == 0) then
    begin
    end
    critter_add_trait(Tandi_ptr, 1, 6, 0);
  end
end

procedure update_party
begin
  variable LVar1 := 0;
  variable LVar2 := 0;

  if (elevation(dude_obj) != party_elevation) then
  begin
    party_elevation := elevation(dude_obj);
    if (global_var(GVAR_IAN_STATUS) == 2) then
    begin
      if (Ian_ptr == 0) then
      begin
      end
      else
        move_to(Ian_ptr, tile_num_in_direction(tile_num(dude_obj), 1, 2), elevation(dude_obj));
    end
    if (global_var(GVAR_DOG_EMPATHY)) then
    begin
      if (Dog_ptr == 0) then
      begin
      end
      else
        move_to(Dog_ptr, tile_num_in_direction(tile_num(dude_obj), 2, 1), elevation(dude_obj));
    end
    if (global_var(GVAR_HERNANDEZ_STATUS) == 2) then
    begin
      if (Tycho_ptr == 0) then
      begin
      end
      else
        move_to(Tycho_ptr, tile_num_in_direction(tile_num(dude_obj), 3, 2), elevation(dude_obj));
    end
    if (global_var(GVAR_KATJA_STATUS) == 2) then
    begin
      if (Katja_ptr == 0) then
      begin
      end
      else
        move_to(Katja_ptr, tile_num_in_direction(tile_num(dude_obj), 4, 2), elevation(dude_obj));
    end
    if (global_var(GVAR_TANDI_STATUS) == 5) then
    begin
      if (Tandi_ptr == 0) then
      begin
      end
      else
        move_to(Tandi_ptr, tile_num_in_direction(tile_num(dude_obj), 4, 4), elevation(dude_obj));
    end
  end
end

procedure remove_party
begin
  if (global_var(GVAR_IAN_STATUS) == 2) then
    set_global_var(GVAR_IAN_STATUS, 2);
  if (global_var(GVAR_DOG_EMPATHY)) then
    set_global_var(GVAR_DOG_EMPATHY, 1);
  if (global_var(GVAR_HERNANDEZ_STATUS) == 2) then
    set_global_var(GVAR_HERNANDEZ_STATUS, 2);
  if (global_var(GVAR_KATJA_STATUS) == 2) then
    set_global_var(GVAR_KATJA_STATUS, 2);
  if (global_var(GVAR_TANDI_STATUS) == 5) then
  begin
  end
end

procedure Darkness
begin
  set_light_level(40);
end

procedure Invasion
begin
  if (not(global_var(GVAR_MASTER_BLOWN) == 2)) then
  begin
    if (global_var(GVAR_NECROPOLIS_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_NECROPOLIS_INVADED, 1);
    if (global_var(GVAR_THE_HUB_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_HUB_INVADED, 1);
    if (global_var(GVAR_BROTHERHOOD_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_BROTHERHOOD_INVADED, 1);
    if (global_var(GVAR_JUNKTOWN_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_JUNKTOWN_INVADED, 1);
    if (global_var(GVAR_SHADY_SANDS_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_SHADY_SANDS_INVADED, 1);
    if (global_var(GVAR_VAULT_13_INVADED_DATE) <= 0) then
      set_global_var(GVAR_VAULT_INVADED, 1);
    if (global_var(GVAR_FOLLOWERS_INVADED_DATE) > (game_time / (10 * 60 * 60 * 24))) then
      set_global_var(GVAR_FOLLOWERS_INVADED, 1);
  end
end
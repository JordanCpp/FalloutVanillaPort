procedure start
begin
  if (script_action == map_enter_proc) then
  begin
    dude_rot := random(0, 5);
    set_global_var(GVAR_SAVE_TANDI_6, 0);
    if ((global_var(GVAR_LOAD_MAP_INDEX) != 1) and metarule(14, 0)) then
    begin
      Ranger_rerolls := has_trait(0, dude_obj, 47);
      set_global_var(GVAR_SAVE_TANDI_5, 0);
      while (Encounter_Num == 0) do
      begin
        Encounter_Num := random(1, 6) + random(1, 6) + random(1, 6);
        if (get_critter_stat(dude_obj, 6) > 8) then
          Encounter_Num := Encounter_Num + 2;
        else if (get_critter_stat(dude_obj, 6) > 6) then
          Encounter_Num := Encounter_Num + 1;
        else if (get_critter_stat(dude_obj, 6) < 3) then
          Encounter_Num := Encounter_Num - 1;
        if ((global_var(GVAR_HUNTER_STATUS) != 3) and (global_var(GVAR_CHILDKILLER_REPUTATION) > 2) and random(0, 1)) then
          Encounter_Num := 7;
        else if (Encounter_Num <= 3) then
          Encounter_Num := 1;
        else if (Encounter_Num <= 5) then
          Encounter_Num := 2;
        else if (Encounter_Num <= 8) then
          Encounter_Num := 3;
        else if (Encounter_Num <= 12) then
          Encounter_Num := 4;
        else if (Encounter_Num <= 15) then
          Encounter_Num := 5;
        else
          Encounter_Num := 6;
        if (global_var(GVAR_WORLD_TERRAIN) == 0) then
          call North_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 1) then
          call South_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 5) then
          call Shady_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 6) then
          call Raider_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 7) then
          call Junk_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 8) then
          call Hub_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 9) then
          call Necrop_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 10) then
          call Steel_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 11) then
          call Vats_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 12) then
          call Glow_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 14) then
          call Death_table;
        else if (global_var(GVAR_WORLD_TERRAIN) == 13) then
          call Bone_table;
        else if (random(0, 1)) then
          call North_table;
        else
          call South_table;
      end
    end
    else if (metarule(14, 0)) then
    begin
      dude_pos := random(0, 3);
      Dude_tile := tile_num(dude_obj);
      call Scenes;
      if (dude_pos == 0) then
        override_map_start(109, 72, 0, dude_rot);
      else if (dude_pos == 1) then
        override_map_start(131, 102, 0, dude_rot);
      else if (dude_pos == 2) then
        override_map_start(90, 112, 0, dude_rot);
      else
        override_map_start(80, 86, 0, dude_rot);
    end
    call Lighting;
  end
  else if (script_action == map_update_proc) then
    call Lighting;
  else if (script_action == map_exit_proc) then
  begin
    Skill_roll := roll_vs_skill(dude_obj, 17, 0);
    if (Scorpions_Killed == 1) then
    begin
      if (is_success(Skill_roll)) then
      begin
        if (is_critical(Skill_roll)) then
          display_msg(message_str(SCRIPT_RNDDESRT, 100));
        else
          display_msg(message_str(SCRIPT_RNDDESRT, 101));
      end
      else if (is_critical(Skill_roll)) then
        display_msg(message_str(SCRIPT_RNDDESRT, 102));
      else
        display_msg(message_str(SCRIPT_RNDDESRT, 103));
    end
  end
end

procedure stranger
begin
  variable LVar1 := 1;

  if (has_trait(0, dude_obj, 46) and (global_var(GVAR_STRANGER_STATUS) == 0) and random(0, 1)) then
  begin
    Critter_type := 16777520;
    Critter_script := 856;
    Critter_direction := random(0, 5);
    Outer_ring := 7;
    Inner_ring := 4;
    call Place_critter;
    Critter_direction := dude_rot + (random(0, 2) - 1);
    while (Critter_direction < 0) do
      Critter_direction := Critter_direction + 6;
    if (Critter_direction > 5) then
      Critter_direction := Critter_direction % 6;
    anim(Critter, 1000, Critter_direction);
    Item := create_object_sid(7, 0, 0, -1);
    add_obj_to_inven(Critter, Item);
    Item := create_object_sid(40, 0, 0, -1);
    add_mult_objs_to_inven(Critter, Item, 2);
    Item := item_caps_adjust(Critter, random(7, 30) * ((2 * has_trait(0, dude_obj, 20)) + 1));
    LVar1 := global_var(GVAR_WATER_THIEF_1);
    if (LVar1 == 1) then
      set_global_var(GVAR_WATER_THIEF_1, 10);
    else if (LVar1 == 2) then
      set_global_var(GVAR_WATER_THIEF_1, 9);
    else
      set_global_var(GVAR_WATER_THIEF_1, 15);
  end
end

procedure Lighting
begin
  variable LVar1 := 0;

  LVar1 := game_time_hour;
  if ((LVar1 >= 600) and (LVar1 < 700)) then
    set_light_level(LVar1 - 600 + 40);
  else if ((LVar1 >= 700) and (LVar1 < 1800)) then
    set_light_level(100);
  else if ((LVar1 >= 1800) and (LVar1 < 1900)) then
    set_light_level(100 - (LVar1 - 1800));
  else
    set_light_level(40);
end

procedure choose_start
begin
  dude_pos := random(0, 3);
  if (global_var(GVAR_WORLD_TERRAIN) == 1) then
  begin
    if (Encounter_Num == 1) then
      override_map_start(93, 91, 0, 1);
    else if (dude_pos == 0) then
      override_map_start(109, 72, 0, dude_rot);
    else if (dude_pos == 1) then
      override_map_start(131, 102, 0, dude_rot);
    else if (dude_pos == 2) then
      override_map_start(90, 112, 0, dude_rot);
    else
      override_map_start(80, 86, 0, dude_rot);
  end
  else if (global_var(GVAR_WORLD_TERRAIN) == 10) then
  begin
    if ((Encounter_Num == 1) or (Encounter_Num == 5) or (Encounter_Num == 6)) then
      override_map_start(100, 100, 0, dude_rot);
    else if (dude_pos == 0) then
      override_map_start(109, 72, 0, dude_rot);
    else if (dude_pos == 1) then
      override_map_start(131, 102, 0, dude_rot);
    else if (dude_pos == 2) then
      override_map_start(90, 112, 0, dude_rot);
    else
      override_map_start(80, 86, 0, dude_rot);
  end
  else if (dude_pos == 0) then
    override_map_start(109, 72, 0, dude_rot);
  else if (dude_pos == 1) then
    override_map_start(131, 102, 0, dude_rot);
  else if (dude_pos == 2) then
    override_map_start(90, 112, 0, dude_rot);
  else
    override_map_start(80, 86, 0, dude_rot);
  Dude_tile := tile_num(dude_obj);
  call Scenes;
end

procedure North_table
begin
  if (Ranger_rerolls) then
  begin
    Ranger_rerolls := Ranger_rerolls - 1;
    if ((Encounter_Num == 1) or (Encounter_Num == 2) or (Encounter_Num == 3) or (Encounter_Num == 4) or (Encounter_Num == 7)) then
      Encounter_Num := 0;
  end
  if (global_var(GVAR_WATER_THIEF_8)) then
  begin
    Encounter_Num := global_var(GVAR_WATER_THIEF_8);
    set_global_var(GVAR_WATER_THIEF_8, 0);
    debug_msg("Northern Desert encounter type: " + Encounter_Num);
  end
  if (Encounter_Num) then
  begin
    call choose_start;
    if (Encounter_Num == 1) then
      call North1;
    else if (Encounter_Num == 2) then
      call North2;
    else if (Encounter_Num == 3) then
      call North3;
    else if (Encounter_Num == 4) then
      call North4;
    else if (Encounter_Num == 5) then
      call North5;
    else if (Encounter_Num == 6) then
      call North6;
    else
      call hunters;
  end
end


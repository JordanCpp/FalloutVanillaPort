procedure Raider2
begin
  variable LVar1 := 0;
  variable LVar2 := 0;

  LVar1 := random(1, 6);
  if (obj_is_carrying_obj_pid(dude_obj, 126)) then
  begin
    display_msg(message_str(SCRIPT_RNDDESRT, 125));
    destroy_object(obj_carrying_pid_obj(dude_obj, 126));
  end
  else
  begin
    Skill_roll := roll_vs_skill(dude_obj, 17, 20 * has_trait(0, dude_obj, 16));
    if (is_success(Skill_roll)) then
    begin
      if (LVar1 == 1) then
        display_msg(message_str(SCRIPT_RNDDESRT, 109));
      else
        display_msg(message_str(SCRIPT_RNDDESRT, 110) + LVar1 + message_str(SCRIPT_RNDDESRT, 111));
    end
    else if (is_critical(Skill_roll)) then
    begin
      LVar2 := random(2, 4);
      if (LVar1 == 1) then
        display_msg(message_str(SCRIPT_RNDDESRT, 112) + LVar2 + message_str(SCRIPT_RNDDESRT, 113));
      else
        display_msg(message_str(SCRIPT_RNDDESRT, 114) + LVar1 + message_str(SCRIPT_RNDDESRT, 115) + LVar2 + message_str(SCRIPT_RNDDESRT, 116));
      critter_injure(dude_obj, 2);
    end
    else
    begin
      LVar2 := random(1, 2);
      if (LVar1 == 1) then
      begin
        if (LVar2 == 1) then
          display_msg(message_str(SCRIPT_RNDDESRT, 117));
        else
          display_msg(message_str(SCRIPT_RNDDESRT, 118) + LVar2 + message_str(SCRIPT_RNDDESRT, 119));
        critter_injure(dude_obj, 2);
      end
      else
      begin
        if (LVar2 == 1) then
          display_msg(message_str(SCRIPT_RNDDESRT, 120) + LVar1 + message_str(SCRIPT_RNDDESRT, 121));
        else
          display_msg(message_str(SCRIPT_RNDDESRT, 122) + LVar1 + message_str(SCRIPT_RNDDESRT, 123) + LVar2 + message_str(SCRIPT_RNDDESRT, 124));
        critter_injure(dude_obj, 2);
      end
    end
    critter_dmg(dude_obj, LVar2, 0);
    LVar1 := LVar1 * 3600;
    game_time_advance(game_ticks(LVar1));
  end
end


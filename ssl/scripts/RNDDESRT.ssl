procedure Place_critter
begin
  variable LVar1 := 0;
  variable LVar2 := 0;

  Critter := create_object_sid(Critter_type, 0, 0, Critter_script);
  Range := random(Inner_ring, Outer_ring);
  LVar1 := random(0, 5);
  Critter_tile := tile_num_in_direction(Dude_tile, Critter_direction, Range);
  LVar2 := tile_num_in_direction(Critter_tile, LVar1, Range / 2);
  if ((tile_distance(Dude_tile, LVar2) <= Outer_ring) and (tile_distance(Dude_tile, LVar2) >= Inner_ring)) then
    Critter_tile := tile_num_in_direction(Critter_tile, LVar1, Range / 2);
  critter_attempt_placement(Critter, Critter_tile, 0);
end


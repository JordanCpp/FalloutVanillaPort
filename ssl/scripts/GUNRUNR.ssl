begin
	gsay_reply(SCRIPT_JON, 110);
	giq_option(4, SCRIPT_JON, 111, Jon04, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_JON, 112, Jon03, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_JON, 113, Jon05, NEUTRAL_REACTION);
end


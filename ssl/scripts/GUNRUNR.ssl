begin
	gsay_reply(SCRIPT_JON, 114);
	giq_option(4, SCRIPT_JON, 115, Jon04, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_JON, 116, Jon05, NEUTRAL_REACTION);
end


procedure start
begin
	if (script_action == critter_proc) then begin
		call critter_p_proc;
	end
	else begin
		if (script_action == destroy_proc) then begin
			call destroy_p_proc;
		end
		else begin
			if (script_action == look_at_proc) then begin
				call look_at_p_proc;
			end
			else begin
				if (script_action == map_enter_proc) then begin
					call map_enter_p_proc;
				end
				else begin
					if (script_action == pickup_proc) then begin
						call pickup_p_proc;
					end
					else begin
						if (script_action == talk_proc) then begin
							call talk_p_proc;
						end
					end
				end
			end
		end
	end
end

procedure critter_p_proc
begin
	if (hostile1) then begin
		hostile1 := 0;
		attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
	end
	else begin
		if (global_var(GVAR_SHERRY_TURNS) == 1) then begin
			if (((game_time / (10 * 60 * 60 * 24)) - local_var(6)) > 1) then begin
				critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 26);
				set_global_var(GVAR_SHERRY_TURNS, 2);
				set_local_var(6, 0);
				home_tile := 18125;
				sleep_tile := 17924;
			end
		end
		if ((game_time_hour >= 700) and (game_time_hour <= 1930)) then begin
			if (tile_num(self_obj) != home_tile) then begin
				animate_move_obj_to_tile(self_obj, home_tile, ANIMATE_WALK);
			end
		end
		call sleeping;
	end
	if (global_var(GVAR_ENEMY_JUNKTOWN) == 1) then begin
		if (obj_can_see_obj(self_obj, dude_obj)) then begin
			attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
		end
	end
end

procedure damage_p_proc
begin
	if (source_obj == dude_obj) then begin
		set_global_var(GVAR_ENEMY_JUNKTOWN, 1);
	end
end

procedure destroy_p_proc
begin
	if (source_obj == dude_obj) then begin
		set_global_var(GVAR_ENEMY_JUNKTOWN, 1);
		if (source_obj == dude_obj) then begin
			if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
				set_global_var(GVAR_BERSERKER_REPUTATION, 1);
				set_global_var(GVAR_CHAMPION_REPUTATION, 0);
			end
			if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
				set_global_var(GVAR_CHAMPION_REPUTATION, 1);
				set_global_var(GVAR_BERSERKER_REPUTATION, 0);
			end
			set_global_var(GVAR_GOOD_MONSTER, global_var(GVAR_GOOD_MONSTER) + 1);
			if ((global_var(GVAR_GOOD_MONSTER) % 2) == 0) then begin
				set_global_var(GVAR_PLAYER_REPUTATION, global_var(GVAR_PLAYER_REPUTATION) - 1);
			end
		end
	end
end

procedure look_at_p_proc
begin
	script_overrides;
	if (local_var(4)) then begin
		display_msg(message_str(SCRIPT_SHERRY, 100));
	end
	else begin
		display_msg(message_str(SCRIPT_SHERRY, 101));
	end
end

procedure map_enter_p_proc
begin
	sleep_time := 2000;
	wake_time := 630;
	if (global_var(GVAR_SHERRY_TURNS) == 0) then begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 14);
		home_tile := 15513;
		sleep_tile := 13494;
	end
	else begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 26);
		home_tile := 18125;
		sleep_tile := 17924;
	end
end

procedure pickup_p_proc
begin
	float_msg(self_obj, message_str(SCRIPT_SHERRY, 102), FLOAT_MSG_NORMAL);
	hostile1 := 1;
end

procedure talk_p_proc
begin
	if (local_var(5) == 1) then begin
		float_msg(self_obj, message_str(SCRIPT_GENVAULT, 166), FLOAT_MSG_NORMAL);
	end
	else begin
		call Get_Reaction;
		start_gdialog(SCRIPT_SHERRY, self_obj, 4, -1, -1);
		gsay_start;
		if (global_var(GVAR_SHERRY_TURNS) == 2) then begin
			call Sherry22;
		end
		else begin
			if (local_var(4) == 1) then begin
				call Sherry15;
			end
			else begin
				call Sherry01;
			end
		end
		gsay_end;
		end_dialogue;
	end
	if (feed_dude) then begin
		call SherryCook;
	end
end

procedure Sherry01
begin
	set_local_var(4, 1);
	gsay_reply(SCRIPT_SHERRY, 103);
	giq_option(4, SCRIPT_SHERRY, message_str(SCRIPT_SHERRY, 104) + proto_data(obj_pid(dude_obj), 1) + message_str(SCRIPT_SHERRY, 105), Sherry02, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_SHERRY, 106, Sherry03, NEUTRAL_REACTION);
	giq_option(-3, SCRIPT_SHERRY, 107, Sherry04, NEUTRAL_REACTION);
end

procedure Sherry02
begin
	gsay_reply(SCRIPT_SHERRY, 108);
	giq_option(4, SCRIPT_SHERRY, 109, SherryCombat, BAD_REACTION);
	giq_option(4, SCRIPT_SHERRY, 110, SherryEnd, NEUTRAL_REACTION);
	giq_option(5, SCRIPT_SHERRY, 111, Sherry05, NEUTRAL_REACTION);
	giq_option(6, SCRIPT_SHERRY, 112, Sherry07, NEUTRAL_REACTION);
end

procedure Sherry03
begin
	call Down_React;
	gsay_reply(SCRIPT_SHERRY, 113);
	giq_option(4, SCRIPT_SHERRY, 114, SherryEnd, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_SHERRY, 115, SherryCombat, NEUTRAL_REACTION);
end


procedure Sherry13
begin
	if (not(local_var(7))) then begin
		giq_option(5, SCRIPT_SHERRY, 133, Sherry09, NEUTRAL_REACTION);
	end
	if (not(local_var(8))) then begin
		giq_option(4, SCRIPT_SHERRY, 132, Sherry12, NEUTRAL_REACTION);
	end
	if (not(local_var(9))) then begin
		giq_option(6, SCRIPT_SHERRY, 134, Sherry14, NEUTRAL_REACTION);
	end
	call Goodbyes;
	giq_option(4, SCRIPT_SHERRY, exit_line, SherryEnd, NEUTRAL_REACTION);
end


procedure critter_p_proc
begin
  if (cur_map_index == MAP_RAIDERS) then begin
    if ((map_var(2) != 0) and (local_var(5) == 0)) then begin
      set_global_var(GVAR_TANDI_STATUS, 5);
      add_timer_event(self_obj, game_ticks(1), 1);
      set_local_var(5, 1);
      if (party_member_obj(16777279) == 0) then begin
        party_add(self_obj);
      end
    end
  end
  if ((global_var(GVAR_TANDI_STATUS) == 5) and (local_var(5) == 0)) then begin
    set_local_var(5, 1);
    if (party_member_obj(16777279) == 0) then begin
      party_add(self_obj);
    end
  end
  if (party_member_obj(16777279) != 0) then begin
    if (tile_distance_objs(self_obj, dude_obj) > 8) then begin
      animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), random(0, 5), 1), ANIMATE_RUN);
    end
    else begin
      if (tile_distance_objs(self_obj, dude_obj) > 4) then begin
        animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), random(0, 5), 3), ANIMATE_WALK);
      end
    end
  end
  if ((cur_map_index == MAP_SHADYW) or (cur_map_index == MAP_SHADYE)) then begin
    if ((global_var(GVAR_TANDI_STATUS) == 1) and (global_var(GVAR_WATER_CHIP_7) == 0)) then begin
      party_add(self_obj);
      set_obj_visibility(self_obj, 1);
      set_global_var(GVAR_WATER_CHIP_7, 1);
    end
    else begin
      if ((global_var(GVAR_TANDI_STATUS) > 1) and (global_var(GVAR_WATER_CHIP_7) == 3)) then begin
        party_remove(self_obj);
        animate_move_obj_to_tile(self_obj, 16710, ANIMATE_WALK);
        set_obj_visibility(self_obj, 0);
        set_global_var(GVAR_WATER_CHIP_7, 4);
      end
    end
  end
  else begin
    if (cur_map_index == MAP_RAIDERS) then begin
      if ((global_var(GVAR_TANDI_STATUS) == 1) and (global_var(GVAR_WATER_CHIP_7) == 1)) then begin
        party_remove(self_obj);
        critter_attempt_placement(self_obj, 17905, 0);
        set_obj_visibility(self_obj, 0);
        set_global_var(GVAR_WATER_CHIP_7, 2);
      end
      else begin
        if ((global_var(GVAR_TANDI_STATUS) == 5) and (global_var(GVAR_WATER_CHIP_7) == 2)) then begin
          party_add(self_obj);
          set_global_var(GVAR_WATER_CHIP_7, 3);
        end
      end
    end
  end
  if ((global_var(GVAR_TANDI_STATUS) != 1) and (global_var(GVAR_TANDI_STATUS) != 5)) then begin
    if (obj_can_see_obj(self_obj, dude_obj)) then begin
      if (global_var(GVAR_ENEMY_SHADY_SANDS) == 1) then begin
        GVar12 := 1;
      end
    end
    if (GVar12) then begin
      GVar12 := 0;
      attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
    end
    call TandiSchedule;
    if (random(1, 20) == 1) then begin
      animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(self_obj), random(0, 5), random(2, 4)), ANIMATE_WALK);
    end
  end
end

procedure Get_Reaction
begin
  if (local_var(2) == 0) then begin
    set_local_var(0, 50);
    set_local_var(1, 2);
    set_local_var(2, 1);
    set_local_var(0, local_var(0) + (5 * get_critter_stat(dude_obj, 3)) - 25);
    set_local_var(0, local_var(0) + (10 * has_trait(0, dude_obj, 10)));
    if (has_trait(0, dude_obj, 39)) then begin
      if (global_var(GVAR_PLAYER_REPUTATION) > 0) then begin
        set_local_var(0, local_var(0) + global_var(GVAR_PLAYER_REPUTATION));
      end
      else begin
        set_local_var(0, local_var(0) - global_var(GVAR_PLAYER_REPUTATION));
      end
    end
    else begin
      if (local_var(3) == 1) then begin
        set_local_var(0, local_var(0) - global_var(GVAR_PLAYER_REPUTATION));
      end
      else begin
        set_local_var(0, local_var(0) + global_var(GVAR_PLAYER_REPUTATION));
      end
    end
    if (global_var(GVAR_CHILDKILLER_REPUTATION) > 2) then begin
      set_local_var(0, local_var(0) - 30);
    end
    if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
      set_local_var(0, local_var(0) + 20);
    end
    if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
      set_local_var(0, local_var(0) - 20);
    end
    call React_To_Level;
  end
end

procedure React_To_Level
begin
  if (local_var(0) <= 25) then begin
    set_local_var(1, 1);
  end
  else begin
    if (local_var(0) <= 75) then begin
      set_local_var(1, 2);
    end
    else begin
      set_local_var(1, 3);
    end
  end
end

procedure Level_To_React
begin
  if (local_var(1) == 1) then begin
    set_local_var(0, random(1, 25));
  end
  else begin
    if (local_var(1) == 2) then begin
      set_local_var(0, random(26, 75));
    end
    else begin
      set_local_var(0, random(76, 100));
    end
  end
end

procedure Up_React
begin
  set_local_var(0, local_var(0) + 10);
  call React_To_Level;
end

procedure Down_React
begin
  set_local_var(0, local_var(0) - 10);
  call React_To_Level;
end

procedure Bottom_React
begin
  set_local_var(1, 1);
  set_local_var(0, 1);
end

procedure Top_React
begin
  set_local_var(0, 100);
  set_local_var(1, 3);
end

procedure Big_Up_React
begin
  set_local_var(0, local_var(0) + 25);
  call React_To_Level;
end

procedure Big_Down_React
begin
  set_local_var(0, local_var(0) - 25);
  call React_To_Level;
end

procedure Up_React_Level
begin
  set_local_var(1, local_var(1) + 1);
  if (local_var(1) > 3) then begin
    set_local_var(1, 3);
  end
  call Level_To_React;
end

procedure Down_React_Level
begin
  set_local_var(1, local_var(1) - 1);
  if (local_var(1) < 1) then begin
    set_local_var(1, 1);
  end
  call Level_To_React;
end

procedure Goodbyes
begin
  GVar13 := message_str(SCRIPT_MODREACT, random(100, 105));
end

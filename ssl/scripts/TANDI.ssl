procedure start
begin
if (GVar11) then begin
    GVar11 := 0;
    if (global_var(GVAR_TANDI_STATUS) == 5) then begin
      add_timer_event(self_obj, game_ticks(1), 2);
    end
    if ((cur_map_index == MAP_SHADYW) or (cur_map_index == MAP_SHADYE)) then begin
      critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 2);
    end
    else begin
      critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 0);
    end
    critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_CAREFUL);
  end
  if (script_action == map_enter_proc) then begin
    call map_enter_p_proc;
  end
  else begin
    if (script_action == map_update_proc) then begin
      call map_update_p_proc;
    end
    else begin
      if (script_action == talk_proc) then begin
        call do_dialogue;
      end
      else begin
        if ((script_action == look_at_proc) or (script_action == description_proc)) then begin
          script_overrides;
          display_msg(message_str(SCRIPT_TANDI, 100));
        end
        else begin
          if (script_action == timed_event_proc) then begin
            if (fixed_param == 1) then begin
              call follow_player;
            end
            else begin
              if (fixed_param == 2) then begin
                call Random_Following;
              end
            end
          end
          else begin
            if (script_action == critter_proc) then begin
              call critter_p_proc;
            end
            else begin
              if (script_action == destroy_proc) then begin
                if (source_obj == dude_obj) then begin
                  if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
                    set_global_var(GVAR_BERSERKER_REPUTATION, 1);
                    set_global_var(GVAR_CHAMPION_REPUTATION, 0);
                  end
                  if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
                    set_global_var(GVAR_CHAMPION_REPUTATION, 1);
                    set_global_var(GVAR_BERSERKER_REPUTATION, 0);
                  end
                  set_global_var(GVAR_GOOD_MONSTER, global_var(GVAR_GOOD_MONSTER) + 1);
                  if ((global_var(GVAR_GOOD_MONSTER) % 2) == 0) then begin
                    set_global_var(GVAR_PLAYER_REPUTATION, global_var(GVAR_PLAYER_REPUTATION) - 1);
                  end
                end
                set_global_var(GVAR_TANDI_STATUS, 3);
              end
              else begin
                if (script_action == damage_proc) then begin
                  if ((source_obj == dude_obj) and ((cur_map_index == MAP_SHADYW) or (cur_map_index == MAP_SHADYE))) then begin
                    set_global_var(GVAR_ENEMY_SHADY_SANDS, 1);
                  end
                end
                else begin
                  if (script_action == pickup_proc) then begin
                    GVar12 := 1;
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

procedure do_dialogue
begin
  variable LVar0 := 0;
  if ((cur_map_index != MAP_RAIDERS) and (cur_map_index != MAP_SHADYW) and (cur_map_index != MAP_SHADYE)) then begin
    float_msg(self_obj, message_str(SCRIPT_TANDI, random(300, 305)), FLOAT_MSG_YELLOW);
  end
  if ((cur_map_index == MAP_RAIDERS) or (cur_map_index == MAP_SHADYW) or (cur_map_index == MAP_SHADYE)) then begin
    LVar0 := BACKGROUND_SHADY_SANDS;
    if (cur_map_index == MAP_RAIDERS) then begin
      LVar0 := BACKGROUND_RAIDERS;
    end
    if (global_var(GVAR_TANDI_STATUS) == 5) then begin
      float_msg(self_obj, message_str(SCRIPT_TANDI, 208), FLOAT_MSG_RED);
    end
    else begin
      start_gdialog(SCRIPT_TANDI, self_obj, 4, HEAD_TANDI, LVar0);
      call Get_Reaction;
      gsay_start;
      if (global_var(GVAR_TANDI_HEREBEFORE) == 1) then begin
        if (global_var(GVAR_TANDI_STATUS) == 0) then begin
          if (get_critter_stat(dude_obj, 4) < 4) then begin
            call tandi06;
          end
          else begin
            call tandi30;
          end
        end
        else begin
          if (global_var(GVAR_TANDI_STATUS) == 1) then begin
            set_global_var(GVAR_TALKED_ABOUT_TANDI, 1);
            call tandi43;
          end
          else begin
            if (global_var(GVAR_TANDI_STATUS) == 2) then begin
              if (cur_map_index == MAP_RAIDERS) then begin
                call tandi43b;
              end
              else begin
                call tandi36;
              end
            end
          end
        end
      end
      else begin
        set_global_var(GVAR_TANDI_HEREBEFORE, 1);
        if (global_var(GVAR_TANDI_STATUS) == 0) then begin
          call tandi01;
        end
        if (global_var(GVAR_TANDI_STATUS) == 1) then begin
          call tandi37;
        end
      end
      gsay_end;
      end_dialogue;
    end
  end
end


procedure TandiSchedule
begin
  variable LVar0 := 0;
  LVar0 := game_time_hour;
  if (LVar0 == 600) then begin
    animate_move_obj_to_tile(self_obj, 18709, ANIMATE_WALK);
  end
  else begin
    if (LVar0 == 610) then begin
      animate_move_obj_to_tile(self_obj, 23232, ANIMATE_WALK);
    end
    else begin
      if (LVar0 == 615) then begin
        animate_move_obj_to_tile(self_obj, 18492, ANIMATE_WALK);
      end
      else begin
        if (LVar0 == 645) then begin
          animate_move_obj_to_tile(self_obj, 13565, ANIMATE_WALK);
        end
        else begin
          if (LVar0 == 650) then begin
            animate_move_obj_to_tile(self_obj, 15683, ANIMATE_WALK);
          end
          else begin
            if (LVar0 == 1000) then begin
              animate_move_obj_to_tile(self_obj, 18709, ANIMATE_WALK);
            end
            else begin
              if (LVar0 == 1200) then begin
                animate_move_obj_to_tile(self_obj, 24678, ANIMATE_WALK);
              end
              else begin
                if (LVar0 == 1300) then begin
                  animate_move_obj_to_tile(self_obj, 23232, ANIMATE_WALK);
                end
                else begin
                  if (LVar0 == 1305) then begin
                    animate_move_obj_to_tile(self_obj, 23701, ANIMATE_WALK);
                  end
                  else begin
                    if (LVar0 == 1600) then begin
                      animate_move_obj_to_tile(self_obj, 17279, ANIMATE_WALK);
                    end
                    else begin
                      if (LVar0 == 1900) then begin
                        animate_move_obj_to_tile(self_obj, 13565, ANIMATE_WALK);
                      end
                      else begin
                        if (LVar0 == 1905) then begin
                          animate_move_obj_to_tile(self_obj, 18709, ANIMATE_WALK);
                        end
                        else begin
                          if (LVar0 == 2100) then begin
                            animate_move_obj_to_tile(self_obj, 24678, ANIMATE_WALK);
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

procedure follow_player
begin
  if (global_var(GVAR_TANDI_STATUS) != 5) then begin
    set_global_var(GVAR_TANDI_ESCAPE, 1);
  end
  if (tile_distance_objs(self_obj, dude_obj) > 8) then begin
    animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), 1, 2), ANIMATE_RUN);
  end
  else begin
    if (tile_distance_objs(self_obj, dude_obj) > 3) then begin
      animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), 1, 2), ANIMATE_WALK);
    end
  end
  add_timer_event(self_obj, game_ticks(3), 1);
end

procedure Random_Following
begin
  if (tile_distance_objs(self_obj, dude_obj) > 8) then begin
    animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), 1, 2), ANIMATE_RUN bwor 16);
  end
  else begin
    if (tile_distance_objs(self_obj, dude_obj) > 3) then begin
      animate_move_obj_to_tile(self_obj, tile_num_in_direction(tile_num(dude_obj), 1, 2), ANIMATE_WALK bwor 16);
    end
  end
  add_timer_event(self_obj, game_ticks(3), 2);
end


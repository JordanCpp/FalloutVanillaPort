	variable LVar0 := 0;
	set_local_var(4, 1);
	set_local_var(5, 1);
	if (dude_is_male) then begin
		gsay_reply(SCRIPT_DOCWU, message_str(SCRIPT_DOCWU, 102));
	end
	else begin
		gsay_reply(SCRIPT_DOCWU, message_str(SCRIPT_DOCWU, 103));

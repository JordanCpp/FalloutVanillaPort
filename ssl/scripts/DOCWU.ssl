procedure start
begin
	if (Only_Once) then begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 20);
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_CHILDREN_TRUE);
		Only_Once := 0;
	end
	if (script_action == talk_proc) then begin
		call do_dialogue;
	end
	else begin
		if (script_action == destroy_proc) then begin
			if (source_obj == dude_obj) then begin
				if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
					set_global_var(GVAR_BERSERKER_REPUTATION, 1);
					set_global_var(GVAR_CHAMPION_REPUTATION, 0);
				end
				if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
					set_global_var(GVAR_CHAMPION_REPUTATION, 1);
					set_global_var(GVAR_BERSERKER_REPUTATION, 0);
				end
				set_global_var(GVAR_BAD_MONSTER, global_var(GVAR_BAD_MONSTER) + 1);
				if ((global_var(GVAR_BAD_MONSTER) % 6) == 0) then begin
					set_global_var(GVAR_PLAYER_REPUTATION, global_var(GVAR_PLAYER_REPUTATION) + 1);
				end
			end
		end
		else begin
			if (script_action == critter_proc) then begin
				if (hostile1) then begin
					hostile1 := 0;
					attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
				end
			end
			else begin
				if ((script_action == look_at_proc) or (script_action == description_proc)) then begin
				end
				else begin
					if (script_action == pickup_proc) then begin
						hostile1 := 1;
					end
					else begin
						if (script_action == timed_event_proc) then begin
							if (fixed_param == 1) then begin
								if ((healing == 1) or (healing == 3)) then begin
									float_msg(dude_obj, message_str(SCRIPT_DOCWU, 138), FLOAT_MSG_RED);
								end
								else begin
									if (healing == 2) then begin
										float_msg(dude_obj, message_str(SCRIPT_DOCWU, 152), FLOAT_MSG_RED);
									end
									else begin
										if (healing == 4) then begin
											float_msg(dude_obj, message_str(SCRIPT_DOCWU, 175), FLOAT_MSG_RED);
										end
										else begin
											if (healing == 5) then begin
												float_msg(self_obj, message_str(SCRIPT_DOCWU, 150), FLOAT_MSG_YELLOW);
											end
											else begin
												if (healing == 6) then begin
													float_msg(self_obj, message_str(SCRIPT_DOCWU, 178), FLOAT_MSG_YELLOW);
												end
											end
										end
									end
								end
								add_timer_event(self_obj, game_ticks(3), 2);
							end
							else begin
								if (fixed_param == 2) then begin
									if (healing < 4) then begin
										float_msg(self_obj, message_str(SCRIPT_DOCWU, 139), FLOAT_MSG_YELLOW);
									end
									else begin
										if (healing == 4) then begin
											float_msg(self_obj, message_str(SCRIPT_DOCWU, 176), FLOAT_MSG_YELLOW);
										end
									end
									add_timer_event(self_obj, game_ticks(3), 3);
								end
								else begin
									if (fixed_param == 3) then begin
										if (healing == 1) then begin
											if (dude_is_male) then begin
												float_msg(self_obj, message_str(SCRIPT_DOCWU, 140), FLOAT_MSG_YELLOW);
											end
											else begin
												float_msg(self_obj, message_str(SCRIPT_DOCWU, 141), FLOAT_MSG_YELLOW);
											end
										end
										else begin
											if (healing == 2) then begin
												float_msg(self_obj, message_str(SCRIPT_DOCWU, 153), FLOAT_MSG_YELLOW);
											end
											else begin
												if (healing == 3) then begin
													if (dude_is_male) then begin
														float_msg(self_obj, message_str(SCRIPT_DOCWU, 167), FLOAT_MSG_YELLOW);
													end
													else begin
														float_msg(self_obj, message_str(SCRIPT_DOCWU, 168), FLOAT_MSG_YELLOW);
													end
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

procedure do_dialogue
begin
	call Get_Reaction;
	start_gdialog(SCRIPT_DOCWU, self_obj, 4, -1, -1);
	gsay_start;
	healing := 0;
	if (local_var(5) == 1) then begin
		call DocWu00;
	end
	else begin
		if (local_var(6) == 1) then begin
			call DocWu01;
		end
		else begin
			if (local_var(7) == 1) then begin
				call DocWu02;
			end
			else begin
				call DocWu03;
			end
		end
	end
	gsay_end;
	end_dialogue;
	if (healing) then begin
		use_obj(dude_obj);
		add_timer_event(self_obj, game_ticks(2), 1);
	end
end

procedure social_skills
begin
	call Get_Reaction;
	dialogue_system_enter;
end


procedure start;
#include <push.h>


procedure start
begin
	if (script_action == use_proc) then begin
		script_overrides;
		if (source_obj == dude_obj) then begin
			reg_anim_func(2, dude_obj);
			move_to(dude_obj, 19701, 0);
		end
	end
end
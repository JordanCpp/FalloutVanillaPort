	giq_option(4, SCRIPT_CATHSHOP, 120, BarterGuy12, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_CATHSHOP, 121, BarterGuy09, NEUTRAL_REACTION);
end

procedure BarterGuy08
begin
	gsay_reply(SCRIPT_CATHSHOP, 122);
	giq_option(-3, SCRIPT_CATHSHOP, 123, BarterGuyEnd, NEUTRAL_REACTION);

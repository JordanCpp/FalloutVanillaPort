procedure BarterGuy11
begin
	gsay_reply(SCRIPT_CATHSHOP, 129);
	giq_option(4, SCRIPT_CATHSHOP, 130, BarterGuyEnd, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_CATHSHOP, 131, BarterGuy01, NEUTRAL_REACTION);

  end
  Critter := create_object_sid(16777229, 0, 0, 644);
  critter_attempt_placement(Critter, ((MapY + 2) * 200) + (MapX + 11), 0);
  anim(Critter, 1000, 3);
  Item := create_object_sid(7, 0, 0, -1);

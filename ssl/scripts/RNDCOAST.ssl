  Critter := create_object_sid(16777258, 0, 0, 645);
  critter_attempt_placement(Critter, ((MapY + 4) * 200) + (MapX + 10), 0);
  anim(Critter, 1000, 3);
  Item := create_object_sid(7, 0, 0, -1);
  add_obj_to_inven(Critter, Item);

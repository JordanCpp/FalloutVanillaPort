	giq_option(4, SCRIPT_HIGHELD, 160, Meeting09, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_HIGHELD, 161, Meeting11, NEUTRAL_REACTION);
	giq_option(-3, SCRIPT_HIGHELD, 138, Meeting13, BAD_REACTION);

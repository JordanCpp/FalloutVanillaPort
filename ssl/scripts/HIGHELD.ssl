	gsay_reply(SCRIPT_HIGHELD, 146);
	if ((global_var(GVAR_NECROPOLIS_INVADED_DATE) < (game_time / (10 * 60 * 60 * 24))) and (global_var(GVAR_NECROPOLIS) == 2)) then begin
		giq_option(4, SCRIPT_HIGHELD, 147, Meeting06, NEUTRAL_REACTION);
	end
	giq_option(4, SCRIPT_HIGHELD, 148, Meeting05a, NEUTRAL_REACTION);
end


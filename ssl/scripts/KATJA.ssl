procedure follow_player
begin
	variable LVar0 := 0;
	prev_tile := dest_tile1;
	LVar0 := (has_trait(1, dude_obj, 10) + random(2, 4)) % 6;
	dest_tile1 := tile_num_in_direction(tile_num(dude_obj), LVar0, (global_var(GVAR_DESTROY_VATS_7) * 2) + random(1, 2));
	if ((tile_distance_objs(self_obj, dude_obj) > ((global_var(GVAR_DESTROY_VATS_7) + 1) * 2)) or (random(0, 3) == 3)) then begin
		if (tile_distance(prev_tile, tile_num(dude_obj)) > tile_distance(dest_tile1, tile_num(dude_obj))) then begin
			if (tile_distance_objs(self_obj, dude_obj) > 8) then begin
				animate_move_obj_to_tile(self_obj, dest_tile1, ANIMATE_RUN bwor 16);
			end
			else begin
				animate_move_obj_to_tile(self_obj, dest_tile1, ANIMATE_WALK bwor 16);
			end
		end
		else begin
			if (tile_distance_objs(self_obj, dude_obj) > 8) then begin
				animate_move_obj_to_tile(self_obj, dest_tile1, ANIMATE_RUN);
			end
			else begin
				animate_move_obj_to_tile(self_obj, dest_tile1, ANIMATE_WALK);
			end
		end
	end
	add_timer_event(self_obj, game_ticks(1), 1);
end

procedure map_commentary
begin
	if (cur_map_index == MAP_MSTRLR12) then begin
		if ((tile_distance(tile_num(self_obj), 27317) < 4) and (line173flag == 0)) then begin
			float_msg(self_obj, message_str(SCRIPT_KATJA, 173), FLOAT_MSG_PURPLE);
			line173flag := 1;
		end
	end
	else begin
		if (cur_map_index == MAP_VAULT13) then begin
			if (elevation(self_obj) == 1) then begin
				if (tile_distance(tile_num(self_obj), 19111) < 4) then begin
					if ((line174flag == 0) and (global_var(GVAR_CALM_REBELS) != 2) and (Ian_ptr != 0)) then begin
						float_msg(self_obj, message_str(SCRIPT_KATJA, 172), FLOAT_MSG_PURPLE);
						line174flag := 1;
					end
				end
			end
		end
		else begin
			if (cur_map_index == MAP_HUBDWNTN) then begin
				if ((tile_distance(tile_num(self_obj), 28104) < 5) and (line176flag == 0)) then begin
					float_msg(self_obj, message_str(SCRIPT_KATJA, 176), FLOAT_MSG_PURPLE);
					if (global_var(GVAR_HERNANDEZ_STATUS) == 2) then begin
						float_msg(Tycho_ptr, message_str(SCRIPT_TYCHO, 167), FLOAT_MSG_LIGHT_GREY);
					end
					line176flag := 1;
				end
			end
			else begin
				if (cur_map_index == MAP_MBVATS12) then begin
					if (line184flag == 0) then begin
						float_msg(self_obj, message_str(SCRIPT_KATJA, 184), FLOAT_MSG_PURPLE);
						if (global_var(GVAR_IAN_STATUS) == 2) then begin
							float_msg(Ian_ptr, message_str(SCRIPT_IAN, 175), FLOAT_MSG_NORMAL);
						end
						line184flag := 1;
					end
				end
				else begin
					if (cur_map_index == MAP_MSTRLR34) then begin
						if (line186flag == 0) then begin
							float_msg(self_obj, message_str(SCRIPT_KATJA, 186), FLOAT_MSG_PURPLE);
							line186flag := 1;
						end
					end
					else begin
						if (cur_map_index == MAP_HALLDED) then begin
							if ((tile_distance(tile_num(self_obj), 17274) < 4) and (line187flag == 0)) then begin
								float_msg(self_obj, message_str(SCRIPT_KATJA, 187), FLOAT_MSG_PURPLE);
								line187flag := 1;
							end
						end
						else begin
							if (cur_map_index == MAP_LARIPPER) then begin
								if (line188flag == 0) then begin
									float_msg(self_obj, message_str(SCRIPT_KATJA, 188), FLOAT_MSG_PURPLE);
									line188flag := 1;
								end
							end
						end
					end
				end
			end
		end
	end
end

procedure pick_lock
begin
	reg_anim_func(2, self_obj);
	reg_anim_func(1, 1);
	reg_anim_obj_move_to_obj(self_obj, lock, -1);
	reg_anim_animate(self_obj, 11, -1);
	reg_anim_func(3, 0);
	use_obj(lock);
	obj_unlock(lock);
	lock := 0;
end

procedure set_lock
begin
	if (cur_map_index == MAP_MBENT) then begin
		lock := map_var(3);
	end
	else begin
		if (cur_map_index == MAP_JUNKENT) then begin
			lock := map_var(4);
		end
	end
end
	giq_option(4, SCRIPT_KATJA, message_str(SCRIPT_KATJA, 103) + proto_data(obj_pid(dude_obj), 1) + message_str(SCRIPT_KATJA, 104), Katja02, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_KATJA, 105, Katja02, NEUTRAL_REACTION);

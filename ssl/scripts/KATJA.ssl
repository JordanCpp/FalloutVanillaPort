procedure Katja24
begin
	gsay_reply(SCRIPT_KATJA, 163);
	if (cur_map_index == MAP_MBENT) then begin
		if (map_var(3)) then begin
			giq_option(4, SCRIPT_KATJA, 164, set_lock, NEUTRAL_REACTION);
		end
	end
	if ((cur_map_index == MAP_JUNKENT) and (elevation(dude_obj) == 1)) then begin
		if (map_var(4)) then begin
			giq_option(4, SCRIPT_KATJA, 164, set_lock, NEUTRAL_REACTION);
		end
	end
	giq_option(4, SCRIPT_TYCHO, 159, KatjaTactics, GOOD_REACTION);
	giq_option(4, SCRIPT_KATJA, 177, Katja26, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_KATJA, 174, Katja27, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_KATJA, 167, KatjaLeave, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_KATJA, 168, KatjaEnd, NEUTRAL_REACTION);
	giq_option(-3, SCRIPT_KATJA, 168, KatjaEnd, NEUTRAL_REACTION);
	giq_option(-3, SCRIPT_KATJA, 190, KatjaLeave, NEUTRAL_REACTION);
end


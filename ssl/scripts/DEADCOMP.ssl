procedure start;
#include <push.h>
procedure do_stuff;


procedure start
begin
	if (script_action == use_proc) then begin
		script_overrides;
		call do_stuff;
	end
end

procedure do_stuff
begin
	display_msg(message_str(SCRIPT_DEADCOMP, 100));
end
	else begin
		gsay_reply(SCRIPT_FGTCARVN, message_str(SCRIPT_FGTCARVN, 106) + message_str(SCRIPT_FGTCARVN, 108) + DayString + message_str(SCRIPT_FGTCARVN, 111));

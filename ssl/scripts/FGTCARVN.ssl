							end
							else begin
								if (LVar0 == 8) then begin
									DayString := message_str(SCRIPT_FGTCARVN, 211);
								end
								else begin
									if (LVar0 == 9) then begin
										DayString := message_str(SCRIPT_FGTCARVN, 212);
									end
									else begin

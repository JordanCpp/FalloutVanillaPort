	if (global_var(GVAR_CALM_REBELS) != 2) then begin
		set_global_var(GVAR_CALM_REBELS, 2);
		exp_flag := 0;
		line := 10;
	end
	gsay_message(SCRIPT_THERESA, 172, NEUTRAL_REACTION);
end


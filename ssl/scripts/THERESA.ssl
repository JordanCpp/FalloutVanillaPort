procedure Theresa21
begin
	if (local_var(7)) then begin
		call Theresa25;
	end
	else begin
		set_local_var(7, 1);
		if (is_success(roll_vs_skill(dude_obj, 14, 0))) then begin
			exp_flag := 1;
			set_global_var(GVAR_CALM_REBELS, 2);
			line := 10;
			gsay_message(SCRIPT_THERESA, 154, NEUTRAL_REACTION);
		end
		else begin
			gsay_reply(SCRIPT_THERESA, 155);
			giq_option(4, SCRIPT_THERESA, 156, TheresaCombat, BAD_REACTION);
			giq_option(4, SCRIPT_THERESA, 157, TheresaEnd, NEUTRAL_REACTION);
		end
	end
end


	giq_option(4, SCRIPT_THERESA, 109, Theresa07, NEUTRAL_REACTION);
	giq_option(6, SCRIPT_THERESA, 110, Theresa02a, NEUTRAL_REACTION);
end

procedure Theresa02a
begin
	variable LVar0 := 0;
	if (not(local_var(7))) then begin
		set_local_var(7, 1);
		LVar0 := roll_vs_skill(dude_obj, 14, 0);
		if (is_success(LVar0)) then begin
			call Theresa08;
		end
		else begin
			call Theresa09;
		end
	end
	else begin
		call Theresa25;
	end
end


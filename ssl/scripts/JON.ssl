procedure Start
begin
	if (Initialize) then begin
		if (obj_is_carrying_obj_pid(self_obj, 41) == 0) then begin
			item_caps_adjust(self_obj, random(50, 150));
		end
		if (global_var(GVAR_BLADES) == 9103) then begin
			if (global_var(GVAR_ZIMMERMAN) != 9003) then begin
				critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 89);
			end
			else begin
				critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 0);
			end
		end
		else begin
			critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 49);
		end
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_PEASANT);
		JonPtr := self_obj;
		Initialize := 0;
	end
end

procedure look_at_p_proc
begin
	script_overrides;
	if (local_var(4) == 1) then begin
		display_msg(message_str(SCRIPT_JON, 176));
	end
	else begin
		display_msg(message_str(SCRIPT_JON, 175));
	end
end

procedure description_p_proc
begin
	script_overrides;
	if (local_var(4) == 1) then begin
		display_msg(message_str(SCRIPT_JON, 176));
	end
	else begin
		display_msg(message_str(SCRIPT_JON, 175));
	end
end

procedure talk_p_proc
begin
	if (global_var(GVAR_ENEMY_ADYTUM) == 1) then begin
		float_msg(self_obj, message_str(SCRIPT_ENEMY, random(100, 105)), FLOAT_MSG_RED);
	end
	else begin
		if ((local_var(4) == 1) and (get_critter_stat(dude_obj, 4) < 4)) then begin
			float_msg(self_obj, message_str(SCRIPT_JON, 139), FLOAT_MSG_NORMAL);
		end
		else begin
			if (global_var(GVAR_ZIMMERMAN) == 2) then begin
				float_msg(self_obj, message_str(SCRIPT_JON, random(183, 187)), FLOAT_MSG_NORMAL);
			end
			else begin
				call Get_Reaction;
				start_gdialog(SCRIPT_JON, self_obj, 4, -1, -1);
				gsay_start;
				DisplayMessage := 100;
				if (local_var(4) == 0) then begin
					call Zim00;
				end
				else begin
					if (global_var(GVAR_ZIMMERMAN) == 0) then begin
						call Zim01;
					end
					else begin
						if (obj_is_carrying_obj_pid(dude_obj, 238)) then begin
							if (global_var(GVAR_ZIMMERMAN) == 9001) then begin
								call Zim24;
							end
							else begin
								call Zim27;
							end
						end
						else begin
							if (global_var(GVAR_ZIMMERMAN) == 1) then begin
								call Zim17;
							end
							else begin
								if (global_var(GVAR_ZIMMERMAN) == 9001) then begin
									call Zim19;
								end
								else begin
									if (global_var(GVAR_ZIMMERMAN) == 9002) then begin
										call Zim21;
									end
								end
							end
						end
					end
				end
				gsay_end;
				end_dialogue;
			end
		end
	end
end

procedure damage_p_proc
begin
	if (source_obj == dude_obj) then begin
		if (global_var(GVAR_ENEMY_REGULATOR) != 1) then begin
			set_global_var(GVAR_ENEMY_ADYTUM, 1);
			critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 49);
		end
	end
end

procedure destroy_p_proc
begin
	if (source_obj == dude_obj) then begin
		if (global_var(GVAR_ENEMY_REGULATOR) != 1) then begin
			set_global_var(GVAR_ENEMY_ADYTUM, 1);
			critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 49);
		end
		if (source_obj == dude_obj) then begin
			if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_GOOD_MONSTER) > (2 * global_var(GVAR_BAD_MONSTER))) or (global_var(GVAR_BERSERKER_REPUTATION) == 1))) then begin
				set_global_var(GVAR_BERSERKER_REPUTATION, 1);
				set_global_var(GVAR_CHAMPION_REPUTATION, 0);
			end
			if (((global_var(GVAR_BAD_MONSTER) + global_var(GVAR_GOOD_MONSTER)) >= 25) and ((global_var(GVAR_BAD_MONSTER) > (3 * global_var(GVAR_GOOD_MONSTER))) or (global_var(GVAR_CHAMPION_REPUTATION) == 1))) then begin
				set_global_var(GVAR_CHAMPION_REPUTATION, 1);
				set_global_var(GVAR_BERSERKER_REPUTATION, 0);
			end
			set_global_var(GVAR_GOOD_MONSTER, global_var(GVAR_GOOD_MONSTER) + 1);
			if ((global_var(GVAR_GOOD_MONSTER) % 2) == 0) then begin
				set_global_var(GVAR_PLAYER_REPUTATION, global_var(GVAR_PLAYER_REPUTATION) - 1);
			end
		end
	end
end

procedure critter_p_proc
begin
	if (obj_can_see_obj(self_obj, dude_obj)) then begin
		if ((global_var(GVAR_BLADES) == 9103) and (global_var(GVAR_ZIMMERMAN) != 9003)) then begin
			critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 89);
			float_msg(self_obj, message_str(SCRIPT_JON, 174), FLOAT_MSG_RED);
			attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
		end
		else begin
			if (global_var(GVAR_ENEMY_ADYTUM) == 1) then begin
				attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
			end
		end
	end
	if (global_var(GVAR_ENEMY_REGULATOR) == 1) then begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 89);
		attack_complex(dude_obj, 0, 1, 0, 0, 30000, 0, 0);
	end
end

procedure pickup_p_proc
begin
	set_global_var(GVAR_ENEMY_ADYTUM, 1);
end


procedure Zim26
begin
	variable LVar0 := 0;
	LVar0 := obj_carrying_pid_obj(dude_obj, 238);
	rm_obj_from_inven(dude_obj, LVar0);
	gsay_message(SCRIPT_JON, 173, NEUTRAL_REACTION);
	set_global_var(GVAR_ZIMMERMAN, 9003);
	if (global_var(GVAR_BLADES) == 9102) then begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 0);
		set_global_var(GVAR_BLADES, 9103);
	end
	else begin
		critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, 0);
	end
end


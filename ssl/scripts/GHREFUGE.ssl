begin
	gsay_reply(SCRIPT_GHREFUGE, 125);
	giq_option(4, SCRIPT_GHREFUGE, 126, ghoulend, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_GHREFUGE, 127, ghoul03, NEUTRAL_REACTION);
end


	giq_option(4, SCRIPT_GHREFUGE, 130, ghoul09a, NEUTRAL_REACTION);
end

procedure ghoul09a
begin
	call Down_React;
	if (local_var(1) < 2) then begin
		call ghoul03;
	end
	else begin

begin
	gsay_reply(SCRIPT_PATRICK, 108);
	giq_option(4, SCRIPT_PATRICK, 109, Patrick05, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_PATRICK, 110, Patrick06, NEUTRAL_REACTION);
	giq_option(4, SCRIPT_PATRICK, 111, Patrick05, NEUTRAL_REACTION);

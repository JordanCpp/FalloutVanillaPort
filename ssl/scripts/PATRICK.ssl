procedure pickup_p_proc;
procedure talk_p_proc;
procedure flee_dude;
procedure Patrick01;
procedure Patrick02;
procedure Patrick03;
procedure Patrick04;
procedure Patrick05;
procedure Patrick06;
procedure Patrick06a;
